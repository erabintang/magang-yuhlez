# ============================================================
# YUHLEZ - ENVIRONMENT CONFIGURATION
# ============================================================
# Copy file ini ke .env: cp .env.example .env
# Lalu isi nilai yang sesuai dengan environment Anda.
#
# LOCAL DEVELOPMENT:
#   - MySQL dijalankan via Docker: docker compose up -d mysql
#   - APP_URL=http://127.0.0.1:8000
#   - MAIL_MAILER=log (lihat email di log Laravel)
#
# VPS / PRODUCTION:
#   - Ganti SEMUA nilai yang bertanda [VPS: GANTI]
#   - APP_URL=https://yourdomain.com
#   - Gunakan SMTP nyata untuk email (Mailgun, Brevo, dll)
#   - GOOGLE_REDIRECT_URI=https://yourdomain.com/v1/auth/google/callback
# ============================================================

# ── App Settings ──────────────────────────────────────────
APP_NAME=YUHLEZ
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# [VPS: GANTI] APP_ENV=production, APP_DEBUG=false, APP_URL=https://yourdomain.com

# ── Logging ───────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database (MySQL / MariaDB) ────────────────────────────
# Untuk local: jalankan docker compose up -d mysql
# [VPS: GANTI] isi dengan credentials VPS
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yuhlez
DB_USERNAME=root
DB_PASSWORD=

# ── Google OAuth ──────────────────────────────────────────
# Cara dapat:
#   1. Buka https://console.cloud.google.com
#   2. Buat project baru → APIs & Services → Credentials
#   3. Create OAuth 2.0 Client ID (Web Application)
#   4. Tambahkan Authorized redirect URIs:
#      Local:  http://127.0.0.1:8000/v1/auth/google/callback
#      VPS:    https://yourdomain.com/v1/auth/google/callback
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ── Session & Cache ───────────────────────────────────────
# [VPS: REKOMENDASI] SESSION_DRIVER=redis, CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=file

# ── Queue ─────────────────────────────────────────────────
# [VPS: REKOMENDASI] QUEUE_CONNECTION=redis
QUEUE_CONNECTION=database

# ── Filesystem ────────────────────────────────────────────
FILESYSTEM_DISK=public

# ── Email / SMTP ──────────────────────────────────────────
# Local: gunakan log driver (cek storage/logs/laravel.log)
# VPS: gunakan SMTP nyata (Mailgun, Brevo, Gmail App Password, dll)
#
# Contoh Gmail App Password:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=you@gmail.com
#   MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx  (App Password, bukan password biasa)
#   MAIL_ENCRYPTION=tls
#
# Contoh Mailgun:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.mailgun.org
#   MAIL_PORT=587
#   MAIL_USERNAME=postmaster@mg.yourdomain.com
#   MAIL_PASSWORD=your-mailgun-password
#   MAIL_ENCRYPTION=tls
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=yuhlez.notifikasi@gmail.com
MAIL_FROM_NAME=YUHLEZ
