APP_NAME=YUHLEZ
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yuhlez.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ==========================================
# DATABASE - Supabase PostgreSQL
# ==========================================
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=YOUR_SUPABASE_USER
DB_PASSWORD=YOUR_SUPABASE_PASSWORD

# ==========================================
# SESSION
# ==========================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ==========================================
# CACHE & QUEUE
# ==========================================
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ==========================================
# GOOGLE OAUTH (Laravel Socialite)
# ==========================================
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://yuhlez.com/v1/auth/google/callback

# ==========================================
# FRONTEND URL (for redirects)
# ==========================================
FRONTEND_URL=https://yuhlez.com

# ==========================================
# SUPABASE STORAGE (file upload)
# ==========================================
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
STORAGE_BUCKET=yuhlez

# ==========================================
# EMAIL SMTP (Gmail App Password)
# ==========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=yuhlez.notifikasi@gmail.com
MAIL_FROM_NAME="YUHLEZ"

# ==========================================
# FILE UPLOAD LIMITS
# ==========================================
MAX_CV_SIZE_MB=5
MAX_UPLOAD_SIZE_MB=50

# ==========================================
# VITE
# ==========================================
VITE_APP_NAME="${APP_NAME}"
